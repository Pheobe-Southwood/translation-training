PORT=8888
HOST=0.0.0.0
NODE_ENV=development
SITE_PASSWORD=tt8888
INVITATION_CODE=tt8888
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# --- Compliance / site identity -------------------------------------------------
# Real values live only in the server's /var/www/translation-training/.env.
# The ICP filing number is injected at runtime via /site-info.js, never committed.
SITE_NAME=翻译训练 · 考研英语翻译竞技场
SITE_ICP_NUMBER=
SITE_ICP_URL=https://beian.miit.gov.cn/
SITE_PSB_NUMBER=
SITE_PSB_CODE=
SITE_OPERATOR=
SITE_CONTACT_EMAIL=
SITE_POLICY_UPDATED_AT=2026-10-29
TERMS_VERSION=2026-10-29

# HMAC secret for login / spectate tokens (set a long random value in production).
AUTH_SECRET=
# Optional comma-separated extra browser origins; same-origin needs none.
CORS_ORIGINS=
# Set false only when the app is exposed directly without a reverse proxy.
TRUST_PROXY=true
# Optional extra nickname blocklist file (one term per line, # comments).
NICKNAME_BLOCKLIST_FILE=
