{
  "name": "translation-training",
  "version": "1.0.0",
  "description": "Swiss-style PVP English translation training platform powered by DeepSeek",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build:client": "NODE_ENV=production vite build --mode production",
    "build:server": "tsc -p tsconfig.server.json && mkdir -p dist/shared/data && cp src/shared/data/exams.json dist/shared/data/",
    "build": "pnpm build:client && pnpm build:server",
    "start": "node dist/server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.0.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
